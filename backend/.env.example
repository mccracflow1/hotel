# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/hotel
DATABASE_URL_TEST=postgres://user:password@localhost:5432/hotel_test

# ── Autenticación JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_64_chars_aleatorios
JWT_REFRESH_SECRET=cambia_esto_por_otro_64_chars_aleatorios
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MercadoPago (Semana 5) ────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Almacenamiento de archivos (Semana 5) ─────────────────────────────────────
STORAGE_PROVIDER=local
# AWS_BUCKET_NAME=hotel-media
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── URLs del sistema ──────────────────────────────────────────────────────────
API_URL=http://localhost:3000
LANDING_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ── Correo (Semana 2) ─────────────────────────────────────────────────────────
# Si SMTP_HOST no está configurado, forgot-password logea el token en consola (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hotel.com

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
