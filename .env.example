# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Plataforma Hotelera IA
#  Copia este archivo como .env y rellena los valores antes de ejecutar Docker.
#
#    cp .env.example .env
#    docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=cambia_esta_contraseña_segura
POSTGRES_PORT=5432

# ── Puertos expuestos en el host ──────────────────────────────────────────────
BACKEND_PORT=3000
ADMIN_PORT=4200
LANDING_PORT=8080

# ── JWT — OBLIGATORIO: mínimo 64 caracteres cada secreto ─────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplazar_con_secreto_de_64_caracteres_minimo_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=reemplazar_con_otro_secreto_64_caracteres_minimo_xxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m

# ── Entorno de Node.js ────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── SSL hacia PostgreSQL ──────────────────────────────────────────────────────
# false  → Docker local (postgres interno, sin SSL)
# true   → Railway producción (SSL requerido)
REQUIRE_SSL=false

# ── Almacenamiento de medios ──────────────────────────────────────────────────
# Opciones: 'local' (volumen Docker) | 's3' (AWS S3 o compatible)
STORAGE_PROVIDER=local
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/uploads
UPLOAD_MAX_BYTES=10485760       # 10 MB
UPLOAD_MAX_VIDEO_BYTES=209715200 # 200 MB

# ── URLs públicas ─────────────────────────────────────────────────────────────
API_URL=http://localhost:3000
LANDING_URL=http://localhost:8080

# ── MercadoPago (dejar vacío en desarrollo local) ─────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── SMTP (dejar vacío para deshabilitar envío de correos) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hotel.local

# ── AWS S3 (solo si STORAGE_PROVIDER=s3) ─────────────────────────────────────
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BASE_URL=
